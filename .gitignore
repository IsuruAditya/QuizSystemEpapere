# ── Dependencies ──
node_modules/

# ── Build output / generated code ──
.next/
out/
next-env.d.ts
*.tsbuildinfo
# Prisma client is generated by `prisma generate` (run in `npm run build` and CI)
src/generated/

# ── Environment and secrets (only the documented template is committed) ──
.env
.env.*
!.env.example
.vercel/

# ── Local services and data (dev/test only) ──
# Embedded PostgreSQL data directory (npm run db:local:start)
.local-pg/
# Locally stored uploads (MEDIA_STORE=local)
.local-media/
# Downloaded tools (e.g. k6 binary)
.tools/

# ── Test and load-test artefacts ──
coverage/
playwright-report/
blob-report/
test-results/
load/results/

# ── Local command logs and scratch output (may contain one-time local credentials) ──
*.log
.lint.json
.audit*
# Local secret-scan reports (list local files such as .env; never commit)
.gitleaks-*.json
results.sarif
npm-debug.log*

# ── OS / editor ──
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
