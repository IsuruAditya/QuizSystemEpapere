# e-Paperé Exams — environment variables (names and explanations only; never commit real values).
# Copy to .env for local development. In Vercel set them per environment (Production / Preview / Development).

# APP_ENV: local | test | preview | production. Guards against preview using production resources.
APP_ENV=local

# Runtime PostgreSQL URL. Production/preview: Neon *pooled* connection string (host contains "-pooler"), sslmode=require.
# Local: embedded server started by `npm run db:local:start`.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/epapere_dev

# Direct (non-pooled) URL used only by `prisma migrate deploy`. Neon: the non-pooler host.
DIRECT_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/epapere_dev

# Max pg connections per server instance (keep small on serverless; see docs/deployment.md pool budget).
DATABASE_POOL_MAX=5

# Integration tests database (must NOT be the dev or production database; tests truncate it).
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/epapere_test

# Better Auth signing secret: >= 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Public origin of this deployment, e.g. https://exams.example.lk (local: http://localhost:3000).
APP_ORIGIN=http://localhost:3000

# Extra comma-separated origins allowed for mutations (e.g. a Vercel preview domain). Optional.
APP_EXTRA_ORIGINS=

# Bearer secret for /api/internal/jobs/run (Vercel Cron sends it automatically as CRON_SECRET). >= 32 chars.
CRON_SECRET=

# Media storage: "local" (filesystem under MEDIA_LOCAL_DIR, dev/test only) or "vercel-blob" (private store).
MEDIA_STORE=local
MEDIA_LOCAL_DIR=.local-media
# Vercel Blob read-write token for a PRIVATE store (set by Vercel when the store is connected).
BLOB_READ_WRITE_TOKEN=

# Upload limits
IMPORT_MAX_BYTES=1048576
IMPORT_MAX_ROWS=500
MEDIA_MAX_BYTES=2097152

# Header holding the client IP set by the platform proxy (Vercel: x-forwarded-for / x-real-ip).
CLIENT_IP_HEADER=x-real-ip

# Log level: debug | info | warn | error
LOG_LEVEL=info
